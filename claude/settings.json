{
  "permissions": {
    "allow": [
      "Bash(chmod:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose ps:*)",
      "Bash(done)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh api:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr view:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git revert:*)",
      "Bash(git stash:*)",
      "Bash(grep:*)",
      "Bash(kubectl cp:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl pod enter production core web psql '$DATABASE_URL')",
      "Bash(kubectx:*)",
      "Bash(make help:*)",
      "Bash(make lint-fix:*)",
      "Bash(make lint:fix:*)",
      "Bash(make pack-check:*)",
      "Bash(make single-test:*)",
      "Bash(make:*)",
      "Bash(node:*)",
      "Bash(npx vitest:*)",
      "Bash(nvm use:*)",
      "Bash(source ~/.nvm/nvm.sh)",
      "Bash(standardrb --fix:*)",
      "Bash(timeout 120 head:*)",
      "Bash(xargs:*)",
      "Bash(yarn lint:fix:*)",
      "Bash(yarn test:*)",
      "Bash(yarn types:*)",
      "Read(*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "mcp__claude_ai_Atlassian__transitionJiraIssue"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); FILE_PATH=$(echo \"$INPUT\" | jq -r '.tool_input.file_path // empty'); if [[ \"$FILE_PATH\" == *\"settings.local.json\" ]]; then $HOME/dotfiles/bin/claude-merge-local-permissions \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" >&2; fi; exit 0"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; echo \"$f\" | grep -qE '\\.tsx?$' && { source ~/.nvm/nvm.sh 2>/dev/null && nvm use && yarn lint:fix \"$f\"; } || true; } 2>/dev/null || true",
            "statusMessage": "Corrigindo lint..."
          }
        ]
      }
    ],
    "UserPromptSubmit": []
  },
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "bash /Users/regishattori/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true,
    "playground@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "language": "pt-BR",
  "effortLevel": "medium",
  "autoDreamEnabled": true,
  "theme": "light",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "Bash(gh api repos/*/pulls/comments/*/replies *)",
      "$defaults"
    ]
  },
  "voiceEnabled": true
}
